# ==========================================
# Telegram API Credentials
# Get your API ID and API Hash from:
# https://my.telegram.org -> API development tools
# ==========================================
TELEGRAM_API_ID=your_telegram_api_id
TELEGRAM_API_HASH=your_telegram_api_hash
TELEGRAM_PHONE=+1234567890

# Optional secondary account phone for multi-account setup
# TELEGRAM_PHONE_2=+1987654321

# Optional custom session name/path (defaults to telegram_session)
# TELEGRAM_SESSION=telegram_session

# ==========================================
# Google Gemini API Key
# Get a free API key at: https://aistudio.google.com
# Used by build_second_brain.py
# ==========================================
GEMINI_API_KEY=your_gemini_api_key

# ==========================================
# Optional Proxy Settings (leave blank if not using proxy)
# Useful in regions where Telegram or Gemini requires a proxy
# Supported proxy types: socks5, socks4, http
# ==========================================
# PROXY_TYPE=socks5
# PROXY_HOST=127.0.0.1
# PROXY_PORT=10808
# PROXY_USERNAME=
# PROXY_PASSWORD=
